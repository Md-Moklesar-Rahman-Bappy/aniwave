# AniWave Telegram Publishing Bot - configuration template.
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored. NEVER commit a real bot token.
#
# The value below is an intentionally invalid placeholder. Generate a real token
# with @BotFather. If a token was ever pasted into a tracked file, a chat or a
# screenshot, revoke it there and create a new one.

# --- Required ---------------------------------------------------------------

# Bot token from @BotFather. Keep it secret.
TELEGRAM_BOT_TOKEN=replace_with_new_token

# Numeric id of the source forum supergroup (usually starts with -100).
# Find it by sending /chatid inside the group.
SOURCE_GROUP_ID=-1001234567890

# Destination channel. Keep the leading @ - this value is used as a string and
# is never converted to an integer.
TARGET_CHANNEL=@your_channel

# Comma-separated numeric Telegram user ids allowed to publish and approve.
ADMIN_IDS=123456789

# Forum topic ids inside SOURCE_GROUP_ID. Send /topicid inside each topic to
# discover the right value. To support a new anime, add an entry to TOPIC_SPECS
# in config.py and a matching variable here.
ONE_PIECE_TOPIC_ID=23
NARUTO_TOPIC_ID=6
BLEACH_TOPIC_ID=8

# false = approval mode (preview + Publish button). true = publish immediately.
AUTO_PUBLISH=false

# Whether generated captions claim "HD Quality".
INCLUDE_HD_CLAIM=false

# IANA timezone, validated at startup.
TIMEZONE=Asia/Dhaka

# SQLite file, relative to the project root.
DATABASE_PATH=aniwave.db

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Optional ---------------------------------------------------------------

# Seconds of quiet after the last album part before the album is finalized.
# Default 3, allowed range 1-120.
ALBUM_QUIET_SECONDS=3