# --- Secrets: never commit real credentials ---
# The sanitised template is the only .env file that may be tracked.
.env
.env.*
!.env.example
*.env
.env.txt
.env.local

# --- Database (keep local data out of git) ---
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.bak

# --- Logs ---
logs/
*.log

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
env.bak/
.venv*/
.python-version

# --- Packaging / build ---
*.egg-info/
build/
dist/
.eggs/

# --- Test + coverage artefacts ---
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.cache

# --- Type checkers / linters ---
.mypy_cache/
.ruff_cache/
.dmypy.json

# --- IDE / editor ---
.idea/
.vscode/
*.swp
*.swo
