# Telegram bot token from @BotFather. Keep this value a secret.
# Format: 1234567890:AAExampleToken...  (never commit a real value)
TELEGRAM_BOT_TOKEN=

# Numerical ID of the "AniWave Database" supergroup.
# (example: -1001234567890)
SOURCE_GROUP_ID=

# Public channel to publish anime episodes to.
TARGET_CHANNEL=@aniwavebd

# Comma-separated list of Telegram numeric admin IDs allowed to manage/approve.
# (example: 123456789)
ADMIN_IDS=6589890362

# Forum topic IDs inside SOURCE_GROUP_ID.
# Get them with the /topicid /debug commands while inside each topic.
ONE_PIECE_TOPIC_ID=
NARUTO_TOPIC_ID=
BLEACH_TOPIC_ID=

# false = safe approval mode (admin preview + Publish button before going live).
# true  = publish every valid upload immediately, no per-item approval.
AUTO_PUBLISH=false

# Whether the generated caption claims "HD Quality".
INCLUDE_HD_CLAIM=false

# Timezone used for displayed timestamps.
TIMEZONE=Asia/Dhaka

# Path to the SQLite database file (relative to project root).
DATABASE_PATH=aniwave.db

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO